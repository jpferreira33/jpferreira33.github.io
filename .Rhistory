r =r %>% mutate(Circuito=as.numeric(Circuito))
voto_circuito=r %>% filter(is.na(Circuito)==FALSE) %>%
count(Circuito) %>% rename(n_i=n)
#Cantidad de votos emitidos (N_i)
#hay circuitos duplicados (los saco) DE LOCOS
cant_votos_circuito=readxl::read_xlsx('Desktop/Ponderación primera vuelta/TOTALES MESAS 2024.xlsx') %>%
filter(duplicated(Circuito)==FALSE) %>% transmute(Circuito, N_i=emitidos)
# Ajuste no respuesta a nivel de circuito
# primero inclinación y luego por ESTRATO (cambiar en group_by)
s = s  %>% left_join(voto_circuito, by='Circuito') %>%
mutate(R=ifelse(is.na(n_i)==TRUE,0,1)) %>%
group_by(inclinacion) %>% mutate(BW_nr=BW*sum(BW)/sum(BW*R)) %>% ungroup()
# calcula los pesos finales (BW_nr* N_i/n_i)
