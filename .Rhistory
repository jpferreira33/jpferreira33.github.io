filter(is.na(n_i)==FALSE) %>%
filter(n_i>0) %>%
mutate(N_i=ifelse(n_i>N_i,n_i,N_i)) %>%
mutate(BW_circuito=N_i/n_i) %>% select(Circuito,BW_circuito)
