remotes::install_github("jpferreira33/weightflow")
library(weightflow)
dat <- sample_one
# Age groups for the person-level nonresponse cells (NA on non-roster rows is
# fine: those rows are already inactive by then).
dat$age_grp <- cut(dat$age, breaks = c(0, 30, 45, 60, Inf),
labels = c("18-30", "31-45", "46-60", "60+"))
fitted <- weighting_spec(dat, base_weights = pw) |>
# 1. Unknown eligibility: redistribute unknown addresses among the known ones
#    (eligible + ineligible). Here each household is one row, so a plain
#    adjustment suffices; with a take-all roster you'd add cluster = "household_id".
step_unknown_eligibility(unknown = unknown_elig, by = "region") |>
# 2. Drop out-of-scope (ineligible) addresses — after eligibility, no redistribution.
step_drop_ineligible(ineligible = ineligible) |>
# 3. Household-level nonresponse: was the household reached at all?
step_nonresponse(respondent = hh_responded, method = "weighting_class",
by = "region") |>
# 4. Within-household selection: the selected person represents all eligible
#    persons in the household (unequal probability p_within).
step_select_within(prob = p_within) |>
# 5. Person-level nonresponse among the selected persons.
step_nonresponse(respondent = responded, method = "weighting_class",
by = c("region", "sex", "age_grp")) |>
# 6. Calibration to population totals (raking on region and sex).
step_calibrate(method = "raking",
margins = list(region = c(table(population$region)),
sex    = c(table(population$sex)))) |>
prep()
summary(fitted)                       # per-stage diagnostics + Kish deff
w <- collect_weights(fitted)          # final weights (only responding persons remain)
head(w)
cat("\nFinal respondents:", nrow(w),
"| sum of weights:", round(sum(w$.weight)),
"| population:", nrow(population), "\n")
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Map to YOUR data: replace the column names above with yours, e.g.
report_weighting(fitted)
dim(e)
dim(w)
head(w)
collect_weights(fitted)
?collect_weights
collect_weights(fitted, keep_intermediate=TRUE)
?step_select_within
step_select_within
