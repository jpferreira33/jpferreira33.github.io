remove.packages("weightflow")
library(weightflow)
stopifnot(requireNamespace("ranger", quietly = TRUE))   # forest engine
set.seed(2026)
## ---- scale knobs ----------------------------------------------------------
regions     <- c("North", "South", "East", "West", "Centre")
psu_per_reg <- 600L          # PSUs per stratum  -> 3000 PSUs
hh_per_psu  <- 35L           # households per PSU -> ~105k households
f1          <- 0.30          # PSU sampling fraction (stage 1)
f2          <- 0.50          # household sampling fraction (stage 2)
B_pilot     <- 50L           # bootstrap replicates for the timing pilot
B_target    <- 500L          # the full run you would eventually want
cat("Generating population...\n")
t_gen <- system.time({
## ---- household frame: region -> PSU -> household ------------------------
psu_region <- rep(regions, each = psu_per_reg)
P          <- length(psu_region)
psu_id     <- seq_len(P)
hh_psu     <- rep(psu_id, each = hh_per_psu)
hh_region  <- rep(psu_region, each = hh_per_psu)
H          <- length(hh_psu)
hh_id      <- seq_len(H)
hh_status  <- ifelse(runif(H) < 0.06, "ineligible", "eligible")
hh_size    <- ifelse(hh_status == "eligible",
sample(1:5, H, replace = TRUE, prob = c(.30,.30,.20,.12,.08)),
0L)
## ---- population: all persons in eligible households ---------------------
elig_hh   <- hh_id[hh_status == "eligible"]
pe_hh     <- rep(elig_hh, hh_size[elig_hh])
Np        <- length(pe_hh)
pe_region <- hh_region[pe_hh]
pe_psu    <- hh_psu[pe_hh]
pe_sex    <- sample(c("F", "M"), Np, replace = TRUE)
pe_age    <- round(pmin(pmax(rnorm(Np, 42, 18), 18), 95))
base_inc  <- c(North=9.9,South=9.6,East=9.4,West=9.7,Centre=10.0)[pe_region]
pe_income <- round(exp(base_inc + 0.004*(pe_age-42) + ifelse(pe_sex=="M",0.12,0) +
rnorm(Np, 0, 0.45)))
pe_emp    <- rbinom(Np, 1, plogis(-0.5 + 0.03*(pe_age-42) -
0.0004*(pe_age-42)^2 + ifelse(pe_sex=="M",0.3,0)))
age_grp_f <- function(a) cut(a, c(0,30,45,60,Inf),
labels = c("18-30","31-45","46-60","60+"))
pop <- data.frame(person_id = seq_len(Np), household_id = pe_hh, psu = pe_psu,
region = factor(pe_region, levels = regions),
sex = factor(pe_sex, levels = c("F","M")),
age = pe_age, age_grp = age_grp_f(pe_age),
income = pe_income, employed = pe_emp)
})
cat(sprintf("  population: %d persons in %d households, %d PSUs\n", Np, H, P))
cat("Drawing the sample...\n")
t_samp <- system.time({
## ---- two-stage select-one sample ----------------------------------------
samp_psu <- psu_id[runif(P) < f1[1]]
samp_hh  <- hh_id[(hh_psu %in% samp_psu) & (runif(H) < f2)]
m        <- length(samp_hh)
pw_hh    <- as.numeric(1 / (f1 * f2))
st       <- hh_status[samp_hh]
unk           <- runif(m) < 0.05
resolved_elig <- !unk & st == "eligible"
reach         <- resolved_elig & (runif(m) < 0.85)
hhnr          <- resolved_elig & !reach
inelig        <- !unk & st == "ineligible"
## ---- reached households: select ONE person (unequal prob), vectorized ---
reach_hh  <- samp_hh[reach]
sizes     <- hh_size[reach_hh]
long_hh   <- rep(reach_hh, sizes)               # one row per person in reached hh
ng        <- length(long_hh)
pref      <- runif(ng, 0.5, 1.5)                # within-hh selection weights
denom     <- ave(pref, long_hh, FUN = sum)
pr        <- pref / denom                        # selection prob of each person
key       <- runif(ng)^(1 / pref)                # Efraimidis-Spirakis: argmax picks 1
is_sel    <- key == ave(key, long_hh, FUN = max)
sel_hh    <- long_hh[is_sel]
sel_pr    <- pr[is_sel]
ne        <- as.integer(ave(rep(1, ng), long_hh, FUN = sum))[is_sel]
k         <- length(sel_hh)
sx        <- sample(c("F","M"), k, replace = TRUE)
ag        <- round(pmin(pmax(rnorm(k, 42, 18), 18), 95))
reg_sel   <- hh_region[sel_hh]
resp      <- rbinom(k, 1, plogis(0.6 + 0.01*(ag-42) - 0.3*(reg_sel=="West")))
bse       <- c(North=9.9,South=9.6,East=9.4,West=9.7,Centre=10.0)[reg_sel]
inc       <- round(exp(bse + 0.004*(ag-42) + ifelse(sx=="M",0.12,0) + rnorm(k,0,0.45)))
emp       <- rbinom(k, 1, plogis(-0.5 + 0.03*(ag-42) + ifelse(sx=="M",0.3,0)))
sel <- data.frame(
household_id = sel_hh, psu = hh_psu[sel_hh], region = hh_region[sel_hh],
sex = sx, age = ag, pw = pw_hh, status = "eligible",
unknown_elig = 0L, ineligible = 0L, hh_responded = 1L, responded = resp,
n_elig = ne, p_within = sel_pr,
income = ifelse(resp == 1, inc, NA), employed = ifelse(resp == 1, emp, NA),
stringsAsFactors = FALSE)
## ---- placeholder rows (no roster) for unknown / ineligible / hh-NR ------
ph <- function(pos, status, ue, inelg, hhr) {
if (!length(pos)) return(NULL)
h <- samp_hh[pos]
data.frame(household_id = h, psu = hh_psu[h], region = hh_region[h],
sex = NA, age = NA, pw = pw_hh, status = status,
unknown_elig = ue, ineligible = inelg, hh_responded = hhr,
responded = NA, n_elig = NA, p_within = NA,
income = NA, employed = NA, stringsAsFactors = FALSE)
}
samp <- rbind(sel,
ph(which(unk),    "unknown",    1L, 0L, NA),
ph(which(inelig), "ineligible", 0L, 1L, NA),
ph(which(hhnr),   "eligible",   0L, 0L, 0L))
samp$region  <- factor(samp$region, levels = regions)
samp$sex     <- factor(samp$sex, levels = c("F","M"))
samp$age_grp <- age_grp_f(samp$age)
samp$person_id <- seq_len(nrow(samp))
})
cat(sprintf("  sample: %d rows (%d selected persons + placeholders)\n",
nrow(samp), k))
## ---- the long recipe -------------------------------------------------------
make_recipe <- function(data) {
weighting_spec(data, base_weights = pw) |>
step_unknown_eligibility(unknown = unknown_elig, by = "region") |>
step_drop_ineligible(ineligible = ineligible) |>
step_nonresponse(respondent = hh_responded, method = "weighting_class",
by = "region") |>
step_select_within(prob = p_within) |>
step_nonresponse(respondent = responded, method = "propensity",
formula = ~ region + sex + age, engine = "forest",
num_classes = 10) |>
step_calibrate(method = "raking",
margins = list(region  = c(table(pop$region)),
sex     = c(table(pop$sex)),
age_grp = c(table(pop$age_grp)))) |>
step_trim_weights() |>
step_assert(max_deff = 5, on_fail = "warning") |>
step_rescale(to = "n")
}
## ===========================================================================
## PART A — the recipe once
## ===========================================================================
cat("\nPART A: running the full recipe once...\n")
rec <- make_recipe(samp)
t_prep <- system.time({ fitted <- prep(rec) })
print(summary(fitted))
library(help="weightflow")
report_weighting(fitted)
## ---- the long recipe -------------------------------------------------------
make_recipe <- function(data) {
weighting_spec(data, base_weights = pw) |>
step_unknown_eligibility(unknown = unknown_elig, by = "region") |>
step_drop_ineligible(ineligible = ineligible) |>
step_nonresponse(respondent = hh_responded, method = "weighting_class",
by = "region") |>
step_select_within(prob = p_within) |>
step_nonresponse(respondent = responded, method = "propensity",
formula = ~ region + sex + age, engine = "forest",
num_classes = 10) |>
step_calibrate(method = "raking",
margins = list(region  = c(table(pop$region)),
sex     = c(table(pop$sex)),
age_grp = c(table(pop$age_grp)))) |>
step_trim_weights()
}
## ===========================================================================
## PART A — the recipe once
## ===========================================================================
cat("\nPART A: running the full recipe once...\n")
rec <- make_recipe(samp)
t_prep <- system.time({ fitted <- prep(rec) })
print(summary(fitted))
cat(sprintf("\n  prep() time: %.1f s\n", t_prep["elapsed"]))
## ===========================================================================
## PART B — bootstrap, pilot then extrapolation
## ===========================================================================
cat(sprintf("\nPART B: bootstrap pilot with %d replicates...\n", B_pilot))
t_boot <- system.time({
boot <- bootstrap_weights(rec, replicates = B_pilot, strata = "region",
psu = "psu", seed = 1, progress = TRUE)
})
print(boot_mean(boot, "income"))
per_rep <- t_boot["elapsed"] / B_pilot
cat(sprintf("\n  %d replicates: %.1f s  (%.2f s per replicate)\n",
B_pilot, t_boot["elapsed"], per_rep))
cat(sprintf("  estimated time for %d replicates: %.1f min\n",
B_target, per_rep * B_target / 60))
## ---- summary ---------------------------------------------------------------
cat("\n===== TIMING SUMMARY =====\n")
cat(sprintf("  generate population : %.1f s\n", t_gen["elapsed"]))
cat(sprintf("  draw sample         : %.1f s\n", t_samp["elapsed"]))
cat(sprintf("  prep() (full recipe): %.1f s\n", t_prep["elapsed"]))
cat(sprintf("  bootstrap (%d reps) : %.1f s\n", B_pilot, t_boot["elapsed"]))
setwd("~/Desktop/jpsite")
